# Separate database/user on your existing PostgreSQL server, reachable from Docker.
# Do not point this at Twenty's database. Percent-encode special password characters.
CALENDAR_DATABASE_URL=postgresql://katfit_calendar_sync:replace_with_random_hex@postgres-host:5432/katfit_calendar_sync
CALENDAR_HTTP_PORT=3100
PORT=3100
# Optional read-only discovery CLI. Do not put the app password in command arguments.
YANDEX_CALDAV_USERNAME=
YANDEX_CALDAV_APP_PASSWORD=

# Required only for saving a connection in PREVIEW state.
# Generate a separate 32-byte encryption key: openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY=
CALENDAR_ENCRYPTION_KEY_ID=primary
TWENTY_WORKSPACE_ID=
# Generate once with: node -e "console.log(require('node:crypto').randomUUID())"
# Reuse this ID when retrying the same connection setup.
CALENDAR_CONNECTION_ID=
YANDEX_CALDAV_CALENDAR_URL=
CALENDAR_TIMEZONE=Europe/Moscow
# Opt-in read-only ingestion; this does not enable CRM mutations.
CALENDAR_POLLING_ENABLED=false

# Prepare local previews from the CalDAV inbox; does not mutate CRM.
CALENDAR_PREVIEW_ENABLED=false

# Read-only CRM matching for exactly TWENTY_WORKSPACE_ID / CALENDAR_CONNECTION_ID.
CALENDAR_CRM_LOOKUP_ENABLED=false
TWENTY_API_URL=
TWENTY_API_TOKEN=
TWENTY_ALLOW_INSECURE_HTTP=false

# Freeze local creation intents only; does not send commands.
CALENDAR_CREATE_PREPARATION_ENABLED=false

# Persist read-only creation inspection attempts; never sends POST.
CALENDAR_CREATION_RECOVERY_ENABLED=false

# Requires recovery + encryption key; read-only live CalDAV validation.
CALENDAR_LIVE_SOURCE_CHECK_ENABLED=false

# Opt-in creation only; requires recovery, live checks and a verified ACTIVE connection.
CALENDAR_CREATE_SEND_ENABLED=false
# Operator activation uses the configurationVersion shown by the connection.
CALENDAR_EXPECTED_CONFIGURATION_VERSION=

# Participant names are exported to the selected private calendar only when explicitly enabled.
CALENDAR_DESCRIPTION_PREPARATION_ENABLED=false
CALENDAR_EXPORT_SEND_ENABLED=false

# Future single-session schedule changes, separate from creation and descriptions.
CALENDAR_SCHEDULE_PREPARATION_ENABLED=false
CALENDAR_SCHEDULE_SEND_ENABLED=false

# Detect cancellations for operator review; never sends cancellation mutations.
CALENDAR_CANCELLATION_REVIEW_ENABLED=false

# Structured JSON logs: silent | error | info | debug. Debug includes polling cycles.
CALENDAR_LOG_LEVEL=info

# Create a Yandex event for a future CRM-created session, then link for ongoing sync.
CALENDAR_CRM_EXPORT_PREPARATION_ENABLED=false
CALENDAR_CRM_EXPORT_SEND_ENABLED=false
