# Введите значения в Dokploy → Compose → Environment приложения staging.
# Нельзя использовать production PostgreSQL, ключи интеграций или SMTP.
TAG=v2.41.0
HOST_PORT=3001
NODE_PORT=3000
SERVER_URL=http://crm-stage.lan

PG_DATABASE_NAME=twenty_stage
PG_DATABASE_USER=twenty_stage
PG_DATABASE_PASSWORD=CHANGE_ME
PG_DATABASE_HOST=postgres-stage.example.com
PG_DATABASE_PORT=5432

# Сгенерируйте отдельный ключ: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME
FALLBACK_ENCRYPTION_KEY=
